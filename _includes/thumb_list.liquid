{% comment %}
  A list of entries with a small preview image on the left and
  title / date / blurb on the right.
  include.items: array of hashes with title, url, and optionally
    thumb (image path), cover (post cover under /assets/img/posts/),
    date, blurb (falls back to description, e.g. for posts)
  include.limit: show this many, and put the rest behind a "Show N more" toggle
{% endcomment %}
{% assign total = include.items | size %}
{% assign shown = include.limit | default: total %}
<div class="thumb-list">
  {% for item in include.items limit: shown %}
    {% include thumb_row.liquid item=item %}
  {% endfor %}
  {% if total > shown %}
    {% assign hidden = total | minus: shown %}
    <details class="thumb-more">
      <summary>
        <span class="thumb-more-open">Show {{ hidden }} more</span>
        <span class="thumb-more-close">Show less</span>
      </summary>
      {% for item in include.items offset: shown %}
        {% include thumb_row.liquid item=item %}
      {% endfor %}
    </details>
  {% endif %}
</div>
