{% comment %}
  Lists entries from _data/artifacts.yml.
  include.selected=true -> only entries with `selected: true`
{% endcomment %}
{% assign items = site.data.artifacts | sort: 'date' | reverse %}
{% if include.selected %}
  {% assign items = items | where: 'selected', true %}
{% endif %}
<div class="artifacts">
  <div class="table-responsive">
    <table class="table table-sm table-borderless">
      {% for item in items %}
        <tr>
          <th scope="row" style="width: 20%">{{ item.date | date: '%b %d, %Y' }}</th>
          <td>
            <div class="artifact-item">
              {% if item.thumb %}
                <a class="artifact-thumb" href="{{ item.url | relative_url }}" tabindex="-1" aria-hidden="true"
                  ><img src="{{ item.thumb | relative_url }}" alt="" loading="lazy" width="240" height="180"
                ></a>
              {% endif %}
              <div class="artifact-text">
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
                {% if item.blurb -%}
                  <br>
                  <span class="text-muted">{{ item.blurb }}</span>
                {%- endif %}
              </div>
            </div>
          </td>
        </tr>
      {% endfor %}
    </table>
  </div>
</div>
