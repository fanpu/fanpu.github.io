{% comment %}
  Lists the courses in _data/course_notes.yml, grouped by term (newest first).
  That file is generated by _scripts/sync_course_notes.py.
{% endcomment %}
{% assign courses = site.data.course_notes %}
<div class="thumb-list course-notes">
  {% assign last_term = '' %}
  {% for course in courses %}
    {% if course.term != last_term %}
      <div class="thumb-group">{{ course.term }}</div>
      {% assign last_term = course.term %}
    {% endif %}
    {% assign pdf = course.pdf | relative_url %}
    {% assign n = course.lectures | size %}
    <div class="thumb-row" id="notes-{{ course.slug }}">
      <div class="thumb-body">
        <a class="thumb-title" href="{{ pdf }}">{{ course.number }} &nbsp;{{ course.title }}</a>
        <div class="thumb-meta">
          {{ course.instructor }} &middot;
          {% if course.lectures_total > n %}
            {{ n }} of {{ course.lectures_total }} lectures so far
          {% else %}
            {{ n }} lecture{% if n != 1 %}s{% endif %}
          {% endif %}
          &middot; {{ course.pages }} pages
          {% if course.review_anchor %}
            &middot; <a href="{{ '/courses/' | relative_url }}#{{ course.review_anchor }}">review</a>
          {% endif %}
          {% if course.course_url %}
            &middot; <a href="{{ course.course_url }}">course page</a>
          {% endif %}
        </div>
        <details class="notes-lectures">
          <summary>Lectures</summary>
          <ol>
            {% for lec in course.lectures %}
              <li>
                <a href="{{ lec.url | relative_url }}">Lecture {{ lec.number }}</a>
                {% if lec.date != blank %}<span class="notes-date">{{ lec.date | date: '%b %-d' }}</span>{% endif %}
                <span class="notes-topics">{{ lec.topics | join: ' &middot; ' }}</span>
              </li>
            {% endfor %}
          </ol>
        </details>
      </div>
    </div>
  {% endfor %}
</div>
